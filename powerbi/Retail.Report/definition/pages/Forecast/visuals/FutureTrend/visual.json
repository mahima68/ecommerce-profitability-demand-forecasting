{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "FutureTrend",
  "position": {
    "x": 20,
    "y": 120,
    "z": 0,
    "width": 780,
    "height": 580,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Forecast"
                    }
                  },
                  "Property": "week"
                }
              },
              "queryRef": "Forecast.week",
              "nativeQueryRef": "week"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Forecast"
                    }
                  },
                  "Property": "Predicted Units"
                }
              },
              "queryRef": "Forecast.Predicted Units",
              "nativeQueryRef": "Predicted Units"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Forecast"
                    }
                  },
                  "Property": "Lower Range"
                }
              },
              "queryRef": "Forecast.Lower Range",
              "nativeQueryRef": "Lower Range"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Forecast"
                    }
                  },
                  "Property": "Upper Range"
                }
              },
              "queryRef": "Forecast.Upper Range",
              "nativeQueryRef": "Upper Range"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Four historical weeks after Dec 4, 2011 \u2014 choose one series'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "14D"
                }
              }
            },
            "titleWrap": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}